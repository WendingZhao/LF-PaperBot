# Required for a full run
DEEPSEEK_API_KEY=

# GitHub Actions supplies this automatically. Local runs need a token with
# contents and issues write access.
GITHUB_TOKEN=

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LF_GITHUB_REPO=WendingZhao/LF-PaperBot
LF_MAX_DAILY_PAPERS=5
LF_TIMEZONE=Asia/Shanghai
LF_LOOKBACK_DAYS=7
LF_SOURCES=arxiv,crossref,cvf
# Optional real contact address for the Crossref polite pool (no API key).
CROSSREF_MAILTO=
CROSSREF_MAX_PAGES=20
# Empty: discover current/previous year main conferences; history covers all requested years.
# Example: CVPR2026,WACV2026
LF_CVF_VENUES=
ARXIV_API_URL=https://export.arxiv.org/api/query
ARXIV_USER_AGENT=LF-PaperBot/0.1 (https://github.com/WendingZhao/LF-PaperBot; mailto:wendingzhao@users.noreply.github.com)
